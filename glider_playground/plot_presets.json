      "icon": "lens_blur",
      "colour": "gray",
      "x": "time",
      "y": "depth",
      "c": ["SCI_PHASE"],
      "cmap": "discrete_09",
      "invert_y": true,
      "prewarm": false,
      "group": "Core"
    },
    "preset_dive": {
      "label": "Dive",
      "icon": "airline_stops",
      "colour": "gray",
      "group": "Core",
      "x": "time",
